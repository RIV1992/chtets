{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chtets research source card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "venue_status",
    "primary_url",
    "category",
    "evidence_type",
    "read_depth",
    "finding",
    "limitation",
    "candidate_rule",
    "evaluation_hook",
    "resource_access",
    "license_status",
    "priority",
    "checked_date",
    "schema_version",
    "strand",
    "evidence_route",
    "resource_urls",
    "inspected_sections",
    "languages",
    "year"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(RES|COH|FID|REV|VOI|EVA|COM)[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "venue_status": {
      "type": "string",
      "minLength": 1
    },
    "primary_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "type": "string",
      "minLength": 1
    },
    "read_depth": {
      "type": "string",
      "minLength": 1
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    },
    "candidate_rule": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_hook": {
      "type": "string",
      "minLength": 1
    },
    "resource_access": {
      "type": "string",
      "minLength": 1
    },
    "license_status": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": [
        "core",
        "extended"
      ]
    },
    "checked_date": {
      "type": "string",
      "format": "date"
    },
    "schema_version": {
      "const": "1.0"
    },
    "strand": {
      "type": "string",
      "minLength": 1
    },
    "evidence_route": {
      "enum": [
        "conceptual_foundation",
        "literature_synthesis",
        "adjacent_task_transfer",
        "direct_writing_research"
      ]
    },
    "resource_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inspected_sections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2026
    }
  }
}
